/vendor
/backups
/.phpunit.cache
node_modules/

script2.ps1
script.ps1
CHANGELOG.md
.env
.env.*

# Registros sueltos (los logs concretos del servidor E2E ya estan abajo).
*.log

# Claves y certificados: nunca se versionan.
*.pem
*.key
*.p12
*.pfx
*.crt

# /database se versiona (schema.sql, create_tables.ps1 y seeders): sólo se
# ignoran los volcados con datos y las copias de seguridad (v1.8.3).
# Ojo: /database/*.sql sólo afecta a ficheros sueltos en la raíz de
# database/, nunca a database/schema/schema.sql.
/database/backups/
/database/dumps/
/database/*.sql
/database/*.sql.gz
*.dump

# Servidor PHP embebido de los E2E (v1.8.3): PID y log del ultimo arranque.
/tools/e2e/.e2e-server.pid
/tools/e2e/.e2e-server.log
/tools/e2e/.e2e-server.log.err

# Subidas de usuario (logos de tenant, v1.14.0): solo se versiona el .htaccess.
/public/uploads/*
!/public/uploads/.htaccess
